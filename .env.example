# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Painel Supabase > Project Settings > API

# URL do projeto (ex: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" (segura para expor no navegador — protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública final do site (usada em metadata/SEO e sitemap). Em desenvolvimento
# pode deixar como está.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Uso apenas em scripts administrativos locais (NUNCA no frontend) ---
# Chave "service_role" do Supabase — necessária apenas se você rodar scripts
# de administração fora do painel (ex: importação em massa). Nunca commitar
# nem usar em código que roda no navegador.
# SUPABASE_SERVICE_ROLE_KEY=
